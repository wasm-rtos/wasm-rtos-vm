(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_unstable" "clock_time_get" (func $clock (param i32 i64 i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_sizes_get" (func $args_sizes (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_get" (func $args_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "random_get" (func $random (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "poll_oneoff" (func $poll (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_tell" (func $fd_tell (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 16) "hello, ")
  (data (i32.const 32) "wasi\0a")
  ;; iovecs at 0: {16, 7} {32, 5}
  (data (i32.const 0) "\10\00\00\00\07\00\00\00\20\00\00\00\05\00\00\00")
  (func (export "write") (param $fd i32) (result i32)
    (local $e i32)
    (local.set $e (call $fd_write (local.get $fd) (i32.const 0) (i32.const 2) (i32.const 48)))
    (if (local.get $e) (then (return (i32.sub (i32.const 0) (local.get $e)))))
    (i32.load (i32.const 48)))
  ;; a bad buffer: nothing written, EFAULT
  (func (export "write_bad") (result i32)
    (i32.store (i32.const 4) (i32.const 0x10000))
    (call $fd_write (i32.const 1) (i32.const 0) (i32.const 2) (i32.const 48)))
  (func (export "clock") (param $id i32) (result i64)
    (if (call $clock (local.get $id) (i64.const 0) (i32.const 64)) (then (return (i64.const -1))))
    (i64.load (i32.const 64)))
  (func (export "clock_fault") (result i32)
    (call $clock (i32.const 1) (i64.const 0) (i32.const 0xFFFE)))
  ;; argc * 1000 + bytes, then argv[1][0]
  (func (export "args") (result i32)
    (drop (call $args_sizes (i32.const 80) (i32.const 84)))
    (drop (call $args_get (i32.const 96) (i32.const 128)))
    (i32.add (i32.add (i32.mul (i32.load (i32.const 80)) (i32.const 1000)) (i32.mul (i32.load (i32.const 84)) (i32.const 10)))
             (i32.eqz (i32.load8_u (i32.load (i32.const 100))))))
  (func (export "random") (result i32)
    (drop (call $random (i32.const 256) (i32.const 40)))
    (i32.or (i32.load (i32.const 256)) (i32.load (i32.const 292))))
  (func (export "random_trap") (result i32)
    (call $random (i32.const 0xFFF0) (i32.const 32)))
  ;; one clock subscription, relative 5 ms: sleeps
  (func (export "sleep") (result i32)
    (i64.store (i32.const 512) (i64.const 77))
    (i32.store8 (i32.const 520) (i32.const 0))
    (i64.store (i32.const 536) (i64.const 5000000))
    (i32.store16 (i32.const 552) (i32.const 0))
    (drop (call $poll (i32.const 512) (i32.const 600) (i32.const 1) (i32.const 640)))
    (i32.add (i32.mul (i32.load (i32.const 640)) (i32.const 100)) (i32.wrap_i64 (i64.load (i32.const 600)))))
  (func (export "exit") (call $exit (i32.const 3)))
  (func (export "absent") (result i32)
    (call $path_open (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i64.const 0) (i64.const 0) (i32.const 0) (i32.const 0)))
  (func (export "absent2") (result i32)
    (call $fd_tell (i32.const 1) (i32.const 0)))
)
